{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDCoPilot VoiceBridge",
  "mainBinaryName": "voicebridge-ui",
  "version": "0.2.0",
  "identifier": "local.voicebridge.ui",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "web"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "web"
    },
    "frontendDist": "web/dist",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VoiceBridge",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RDM2RDRGMTAzQzRFQzUKUldURlRqd1FUMjNUVmF5amVua21IVjRSemgreGNBd0ZsKytjaE5iWGVqMWJPUVJ6Ni93T21adUsK",
      "endpoints": [
        "https://github.com/Superbrain8/edcopilot-voicebridge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "Voice commands for EDCoPilot",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 the VoiceBridge authors",
    "resources": {
      "../app/voicebridge.example.toml": "resources/voicebridge.example.toml",
      "../core/data/synonyms.toml": "resources/data/synonyms.toml",
      "../core/data/sound_alikes.toml": "resources/data/sound_alikes.toml",
      "../core/data/fillers.toml": "resources/data/fillers.toml",
      "../core/data/hotwords.txt": "resources/data/hotwords.txt",
      "../core/aliases": "resources/aliases"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
